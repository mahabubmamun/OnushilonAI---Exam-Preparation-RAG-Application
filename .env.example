# Copy this file to .env and fill in the values.

# --- Which LLM provider to use ---
# "groq"   -> free, fast, hosted API (recommended default). Get a free key at https://console.groq.com
# "ollama" -> fully local, zero external calls, needs Ollama installed and running on your machine/server
LLM_PROVIDER=groq

# --- Groq settings (only needed if LLM_PROVIDER=groq) ---
GROQ_API_KEY=exam_rag_api
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama settings (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- Retrieval / chunking (same defaults as the Kaggle notebook) ---
CHUNK_SIZE_WORDS=450
CHUNK_OVERLAP_WORDS=80
TOP_K=5
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
MAX_NEW_TOKENS=800
TEMPERATURE=0.3

# --- Where data (uploaded PDFs, saved indices) is stored ---
DATA_DIR=./data
